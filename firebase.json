{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "packages/**",
      "server/**",
      "spec_temp/**",
      "*.zip",
      "*.apk",
      "*.log",
      "*.docx",
      "*.php",
      "*.txt",
      "*.yaml"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|woff2)",
        "headers": [{ "key": "Cache-Control", "value": "max-age=31536000, immutable" }]
      }
    ]
  }
}
